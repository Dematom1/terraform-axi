{
  "name": "terraform-axi",
  "version": "0.1.5",
  "description": "Read-only Terraform and OpenTofu CLI for agents, with compact TOON output",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dematom1/terraform-axi.git"
  },
  "homepage": "https://github.com/Dematom1/terraform-axi#readme",
  "bugs": {
    "url": "https://github.com/Dematom1/terraform-axi/issues"
  },
  "bin": {
    "terraform-axi": "./dist/bin/terraform-axi.js",
    "terraform-axi-ctx": "./dist/bin/terraform-axi-ctx.js"
  },
  "files": [
    "dist/bin",
    "dist/src",
    "skills/terraform-axi",
    "LICENSE",
    "README.md",
    "VISION.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "npm run build && vitest run",
    "test:real": "sh scripts/real-binaries.sh",
    "lint": "oxlint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:skill": "npm run build && node dist/scripts/build-skill.js",
    "check:skill": "npm run build && node dist/scripts/build-skill.js --check",
    "prepack": "npm run build && node dist/scripts/build-skill.js --check"
  },
  "dependencies": {
    "@toon-format/toon": "2.3.1",
    "axi-sdk-js": "0.1.13"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "js-yaml": "4.3.2",
    "oxlint": "1.93.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
